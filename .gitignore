# Virtual environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# DuckDB warehouse (generated)
data/warehouse.duckdb
data/warehouse.duckdb.wal
*.duckdb
*.duckdb.wal

# Generated datasets (recreate with `make data`)
data/raw/batch_*/
data/raw/_injected_issues.csv
data/ground_truth/*.parquet
data/ground_truth/*.csv
data/ground_truth/*.json
!data/raw/.gitkeep
!data/ground_truth/.gitkeep

# Bronze pre-load (recreate with `make dbt`)
data/bronze/*.parquet
!data/bronze/.gitkeep

# dbt artifacts
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/package-lock.yml

# Local dbt profiles copy (template is committed)
# profiles.yml in the project is a committed template-friendly local file;
# ignore a home-level override if one is placed here by mistake
dbt/.user.yml

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# MLflow local file store
ml/mlruns/
ml/mlartifacts/

# Trained model binaries (the model card is committed)
ml/artifacts/*
!ml/artifacts/.gitkeep
