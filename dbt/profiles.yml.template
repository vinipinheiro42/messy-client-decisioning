# Local DuckDB profile for this project.
# From the dbt/ directory:  dbt debug --profiles-dir .
# The warehouse file is gitignored and is created on first dbt run (M2+).
messy_client:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: ../data/warehouse.duckdb
      threads: 4
      # Contract dates are UTC. Without this, DuckDB uses the host TZ
      # (America/Sao_Paulo) and cast(timestamptz as date) shifts early-UTC
      # clock times to the previous calendar day.
      settings:
        TimeZone: UTC
